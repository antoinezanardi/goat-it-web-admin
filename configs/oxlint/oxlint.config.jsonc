    // ---- Override for composable files -----
    {
      "files": [
        "**/app/composables/**/*.ts"
      ],
      "rules": {
        "eslint/max-lines-per-function": "off",
        "unicorn/filename-case": [
          "error",
          {
            "case": "camelCase",
            "multipleFileExtensions": true
          }
        ]
      }
    },
    // ---- Override for repository files and attached files -----
    {
      "files": [
        "**/app/repositories/**/*.ts"
      ],
      "rules": {
        "unicorn/filename-case": [
          "error",
          {
            "case": "kebabCase",
            "multipleFileExtensions": true
          }
        ]
      }
