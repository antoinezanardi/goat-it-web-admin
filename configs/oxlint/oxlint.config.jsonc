          {
            "case": "kebabCase",
            "multipleFileExtensions": true
          }
        ]
      }
    },
    // ---- Override for component files -----
    {
      "files": [
        "**/app/components/**/*.vue"
      ],
      "rules": {
        "import/unambiguous": "off"
      }
    },
    // ---- Override for pages files -----
    {
      "files": [
        "**/app/pages/**/*.vue"
      ],
      "rules": {
        "import/unambiguous": "off",
        "unicorn/filename-case": [
