# This file is used for testing. It should contain the same variables as .env.development, but with test values.

# Default locale used by i18n module
NUXT_PUBLIC_DEFAULT_LOCALE=en

# Goat It API variables
# API base URL
NUXT_GOAT_IT_API_BASE_URL=http://localhost:9090
# API admin key value
NUXT_GOAT_IT_API_ADMIN_KEY=test_admin_api_key_for_testing
