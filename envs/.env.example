# This file is used as a template for environment variables. Copy this file to envs/.env.development and fill in the values.

# Default locale used by i18n module
NUXT_PUBLIC_DEFAULT_LOCALE=en

# Goat It API variables
# API base URL
NUXT_GOAT_IT_API_BASE_URL=http://localhost:9090
# API admin key value
NUXT_GOAT_IT_API_ADMIN_KEY=your_admin_key_here
