    "@nuxt/ui": "^4.5.0",
    "@nuxtjs/i18n": "^10.2.3",
    "@pinia/nuxt": "^0.11.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^14.2.1",
    "@vueuse/nuxt": "^14.2.1",
    "commitlint": "^20.4.2",
    "happy-dom": "^20.7.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^16.2.7",
    "nuxt": "^4.3.1",
    "pinia": "^3.0.4",
    "semantic-release": "^25.0.3",
    "semantic-release-export-data": "^1.2.0",
    "tailwindcss": "^4.2.1",
    "type-fest": "^5.4.4",
    "typescript": "^5.9.3",
    "validate-branch-name": "^1.3.2",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5"
