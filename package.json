    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "prepare": "scripts/post-install-prepare.sh",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "echo \"No lint specified for now\"",
    "test": "pnpm run test:unit:cov",
    "test:unit": "vitest --config configs/vitest/vitest.config.ts",
    "test:unit:watch": "vitest --config configs/vitest/vitest.config.ts --watch",
    "test:unit:cov": "vitest --config configs/vitest/vitest.config.ts --coverage",
    "test:unit:staged": "lint-staged -c configs/lint-staged/.lintstagedrc.unit-tests.json",
    "test:mutation:ci": "echo \"No test specified for now\"",
    "test:acceptance": "echo \"No test specified for now\"",
    "script:create-branch": "scripts/create-git-branch.sh",
    "script:create-pull-request": "scripts/create-pull-request.sh",
    "script:create-release-changelog": "scripts/create-release-changelog.sh",
    "script:clean-pr-description": "scripts/clean-pr-description.sh",
    "validate:branch-name": "(cd configs/validate-branch-name && validate-branch-name)",
    "test:watch": "vitest --watch",
    "test:nuxt": "vitest --project nuxt"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.4.2",
    "@iconify-json/lucide": "^1.2.94",
