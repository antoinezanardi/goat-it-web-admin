{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "orchestrator",
  "provider": {
    "opencode-go": {
      "options": {
        "setCacheKey": true
      }
    }
  },
  "permission": {
    "skill": { "*": "allow" },
    "bash": {
      "git checkout -b *": "allow",
      "git add *": "deny",
      "git commit *": "deny",
      "git push *": "deny",
      "rtk git add *": "deny",
      "rtk git commit *": "deny",
      "rtk git push *": "deny"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 15000
  }
}
