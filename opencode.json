{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/glm-5.1",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "orchestrator",
  "provider": {
    "opencode-go": {
      "options": {
        "timeout": 600000,
        "setCacheKey": true
      }
    }
  },
  "permission": {
    "skill": { "*": "allow" },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git branch*": "allow",
      "git checkout -b *": "allow",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "pnpm *": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 15000
  }
}
